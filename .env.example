# Copy to .env and fill in for your environment. Never commit the real .env.

# --- Core ---
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=medtechmitra.gov.in,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://medtechmitra.gov.in

# --- Database (leave DJANGO_DB_ENGINE unset to use local SQLite) ---
DJANGO_DB_ENGINE=postgres
POSTGRES_DB=medtech_mitra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Security (only enforced when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
